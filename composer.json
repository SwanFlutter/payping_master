{
  "name": "sharexos/payping",
  "description": "Comprehensive PayPing API v3 Package for PHP and Laravel",
  "type": "library",
  "license": "MIT",
  "version": "1.1.0",
  "authors": [
    {
      "name": "ShareXOS Team",
      "email": "support@sharexos.ir"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "illuminate/support": "^9.0|^10.0|^11.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "mockery/mockery": "^1.5"
  },
  "autoload": {
    "psr-4": {
      "ShareXOS\\PayPing\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ShareXOS\\PayPing\\Laravel\\PayPingServiceProvider"
      ],
      "aliases": {
        "PayPing": "ShareXOS\\PayPing\\Laravel\\Facades\\PayPing"
      }
    }
  },
  "minimum-stability": "stable"
}
